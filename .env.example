# PayPal sandbox app credentials (free): developer.paypal.com -> Apps & Credentials -> Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Optional: shown on invoices and used to sign reminders
PAYPAL_BUSINESS_NAME=

# AI provider. Gemini is used when GEMINI_API_KEY is set (free tier: aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional override (default: gemini-3.5-flash)
GEMINI_MODEL=
# Optional: backup models tried when the main one is busy or out of free quota
GEMINI_FALLBACK_MODELS=

# Optional: public URL of the app, used in links sent to clients (Render sets this automatically)
APP_URL=

# Optional paid alternative: Claude (used only if GEMINI_API_KEY is empty)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
